# ═══════════════════════════════════════════════════════════════════
# SAS Retrieval Agent Assistant — settings
#
# Local run:  copy this file to backend/.env and edit it.
# Railway:    set the same names in the service's Variables tab (no file needed).
#
# Keep comments on their own lines: `docker run --env-file` does not strip a
# comment that follows a value.
# ═══════════════════════════════════════════════════════════════════

# ─── The RAM to connect to ───────────────────────────────────────────
# The address of SAS Retrieval Agent Manager. This is the one setting the app
# needs: with it set, people sign in from the page. Either form works:
#   https://your-host/SASRetrievalAgentManager          (the address you open RAM at)
#   https://your-host/SASRetrievalAgentManager/api/v1   (the API base)
RAM_API_URL=

# No RAM at hand? true runs the page on made-up agents and answers instead.
# It only applies while RAM_API_URL is empty: an address always wins.
#RAM_MOCK=true

# false only if the RAM host uses a self-signed certificate
#RAM_VERIFY_SSL=true

# ─── Signing in ──────────────────────────────────────────────────────
# With only RAM_API_URL set, the page shows a "Sign in" button and each person
# signs in as themselves. The backend detects which kind of RAM it is:
#   • Standalone RAM (Keycloak)  → device code: a short code to enter on RAM's page
#   • Full SAS Viya (SASLogon)   → log in on the SAS page, paste the code it shows
# Nothing below is needed for that. Override only if your deployment differs:
#
# device or code, to skip the detection
#RAM_AUTH_FLOW=device
# Keycloak client and realm used by the device flow
#RAM_CLIENT_ID=sas-ram-api
#RAM_REALM=sas-iot
# SASLogon client used by the paste-the-code flow (secret only if the client has one)
#SAS_AUTH_CLIENT_ID=sas.cli
#SAS_AUTH_CLIENT_SECRET=

# Alternative A: one fixed bearer token for everybody (quick demos; it expires
# when RAM says so). No Sign in button; every visitor uses RAM as this token's user.
#RAM_TOKEN=eyJhbGciOi...

# Alternative B: a registered OAuth client. The backend fetches and renews
# tokens itself; again one identity shared by every visitor.
#SAS_CLIENT_ID=ram-chat-ui
# omit the secret for a public client
#SAS_CLIENT_SECRET=
# with a username and password the password grant is used; without, client_credentials
#SAS_USERNAME=
#SAS_PASSWORD=
# Token endpoint. Full Viya: defaults to https://<host>/SASLogon/oauth/token.
# Standalone RAM: the Keycloak realm's token endpoint, as below.
#SAS_LOGON_URL=https://your-ram-host/SASRetrievalAgentManager/auth/realms/sas-iot/protocol/openid-connect/token

# ─── Staying signed in ───────────────────────────────────────────────
# Signed-in sessions are written here so a restart does not sign anyone out.
# On Railway, mount a volume (e.g. at /data) and point this into it so a
# redeploy does not either:  RAM_SESSION_FILE=/data/ram_sessions.json
#RAM_SESSION_FILE=data/runtime/ram_sessions.json
# The browser also keeps a copy of its own refresh token and hands it back if the
# server comes up without the session (a redeploy with no volume). false = keep
# tokens on the server only; people then sign in again after such a redeploy.
#RAM_BROWSER_RESTORE=true
# How often signed-in sessions are checked and renewed before they expire (seconds)
#RAM_KEEPALIVE_SECONDS=60

# ─── History ─────────────────────────────────────────────────────────
# true = do not list RAM's past conversations. Only useful with alternative A
# or B above, where everybody shares one RAM identity and would otherwise see
# each other's conversations.
#RAM_HIDE_HISTORY=false

# ─── Queries ─────────────────────────────────────────────────────────
# Questions are submitted asynchronously and polled, so a slow agent is never
# cut off by a gateway timeout. How long to wait for an answer, and how often to poll:
#RAM_QUERY_TIMEOUT=600
#RAM_QUERY_POLL_INTERVAL=2

# ─── Rarely needed ───────────────────────────────────────────────────
# Only if the frontend is hosted on a different origin than this backend:
# the allowed origins, comma-separated. Leave unset otherwise.
#CORS_ORIGINS=https://my-frontend.example.com
