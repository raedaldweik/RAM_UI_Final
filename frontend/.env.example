# Frontend build settings (Vite). Optional: only the interactive TomTom map card
# uses them; everything else works without.
#
# These are read when the frontend is BUILT, not when it runs:
#   npm run dev      copy this file to frontend/.env.local
#   docker build     --build-arg VITE_TOMTOM_API_KEY=...
#   Railway          add a service variable with the same name, then redeploy

# TomTom API key the browser uses for map tiles and live traffic tiles.
# It ends up in the page, so use a key restricted to your site's domain.
VITE_TOMTOM_API_KEY=

# Optional: a TomTom (or any MapLibre) vector style URL to use instead of the
# default. If the URL has no `key=` parameter, VITE_TOMTOM_API_KEY is appended.
VITE_MAP_STYLE_URL=

# Optional: true forces the flat raster basemap (no 3D buildings).
VITE_MAP_RASTER=
